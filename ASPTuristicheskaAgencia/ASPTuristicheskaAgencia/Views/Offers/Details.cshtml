@model ASPTuristicheskaAgencia.Data.Offer

<div class="card offer-details-card">
    <img src="@Model.ImageURL" class="details-image" />

    <div class="card-body">
        <h2>@Model.Name</h2>
        <p><strong>Destination:</strong> @Model.Destination</p>
        <p><strong>Category:</strong> @Model.Category.CategoryName</p>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Dates:</strong> @Model.StartDate - @Model.EndDate</p>
        <p><strong>Services:</strong> @Model.IncludedServices</p>
        <p><strong>Price:</strong> @Model.Price €</p>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>