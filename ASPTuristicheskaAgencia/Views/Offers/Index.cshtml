@model IEnumerable<ASPTuristicheskaAgencia.Data.Offer>

@{
    ViewData["Title"] = "Оферти";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🌍 Оферти за пътуване</h1>

    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Добави оферта</a>
    }
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card offer-card h-100">
                <img src="@item.ImageURL" class="card-img-top offer-image" alt="@item.Name" />

                <div class="card-body">
                    <h4>@item.Name</h4>
                    <p>📍 @item.Destination</p>
                    <p>🏷️ @item.Category.CategoryName</p>
                    <p>💶 <strong>@item.Price лв.</strong></p>
                    <p>@item.Description</p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Редактирай</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Детайли</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Изтрий</a>
                    }
                    else if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Reservations"
                           asp-action="Create"
                           asp-route-offerId="@item.Id"
                           class="btn btn-success btn-sm">
                            Резервирай
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="btn btn-success btn-sm">
                            Влез, за да резервираш
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>