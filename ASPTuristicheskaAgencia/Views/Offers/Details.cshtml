@model ASPTuristicheskaAgencia.Data.Offer

<div class="card offer-details-card">
    <img src="@Model.ImageURL" class="details-image" />

    <div class="card-body">
        <h2>@Model.Name</h2>
        <p><strong> Дестинация:</strong> @Model.Destination</p>
        <p><strong>Категория:</strong> @Model.Category.CategoryName</p>
        <p><strong>Описание:</strong> @Model.Description</p>
        <p><strong>Дата:</strong> @Model.StartDate - @Model.EndDate</p>
        <p><strong>Услуги:</strong> @Model.IncludedServices</p>
        <p><strong>Цена:</strong> @Model.Price €</p>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>