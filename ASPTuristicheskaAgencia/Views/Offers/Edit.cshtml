@model ASPTuristicheskaAgencia.Data.Offer

@{
    ViewData["Title"] = "Редактирай оферта";
}

<h2 class="text-center mb-4">✏️ Редактирай оферта</h2>

<div class="auth-box">
    <form asp-action="Edit">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">Име</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Destination">Дестинация</label>
            <input asp-for="Destination" class="form-control" />
            <span asp-validation-for="Destination" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId">Категория</label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description">Описание</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StartDate">Начална дата</label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EndDate">Крайна дата</label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IncludedServices">Включени услуги</label>
            <input asp-for="IncludedServices" class="form-control" />
            <span asp-validation-for="IncludedServices" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price">Цена</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        @* CreatedOn можеш да го махнеш от UI ако не искаш да се редактира *@

        <div class="mb-3">
            <label asp-for="ImageURL">Снимка</label>
            <input asp-for="ImageURL" class="form-control" />
            <span asp-validation-for="ImageURL" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">💾 Запази</button>

        <a asp-action="Index" class="btn btn-secondary w-100 mt-2">⬅ Назад</a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}