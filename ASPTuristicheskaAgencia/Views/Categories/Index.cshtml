@model IEnumerable<ASPTuristicheskaAgencia.Data.Category>

@{
    ViewData["Title"] = "Категории";
}

<h2 class="mb-4 text-center">📂 Категории</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="category-box p-4 h-100 text-center">

                <h4 class="mb-3">@item.CategoryName</h4>

                <p class="text-muted">@item.Description</p>

                <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Offers"
                       asp-action="ByCategory"
                       asp-route-id="@item.Id"
                       class="btn btn-success btn-sm">
                        Виж оферти
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Редактирай</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Детайли</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Изтрий</a>
                    }
                </div>

            </div>
        </div>
    }
</div>

@if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
{
    <div class="text-center mt-4">
        <a asp-action="Create" class="btn btn-primary">+ Добави категория</a>
    </div>
}