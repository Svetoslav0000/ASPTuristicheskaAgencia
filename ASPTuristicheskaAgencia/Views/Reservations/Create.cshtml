@using ASPTuristicheskaAgencia.Data
@model ASPTuristicheskaAgencia.Data.Reservation

@{
    ViewData["Title"] = "Създай резервация";
}

<h2 class="text-center mb-4">📅 Нова резервация</h2>

<div class="auth-box">
    <form asp-action="Create">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="OfferId" class="form-label">Оферта</label>
            <select asp-for="OfferId" class="form-control" asp-items="ViewBag.OfferId"></select>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Статус</label>
            <select asp-for="Status" class="form-control"
                    asp-items="@Html.GetEnumSelectList<ReservationStatus>()">
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Създай</button>

        <a asp-action="Index" class="btn btn-secondary w-100 mt-2">⬅ Назад</a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
